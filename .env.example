# --- Public address of the service ----------------------------------------
ROOT_URL=https://localhost

# --- Shared (same for everyone) primary entry -----------------------------
# Single path; can be masked with an arbitrary segment (e.g. /x7f2).
PRIMARY_URL_PATH=/login

# --- Administrator (seeded on first start only) ---------------------------
ADMIN_LOGIN=admin
ADMIN_PRIMARY_PASSWORD=change-me-primary-password

# --- Security -------------------------------------------------------------
# 64 random bytes, hex/base64. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-please-use-a-long-random-secret-value-0123456789abcdef
# Set to false ONLY for local plain-http testing (Secure cookie flag).
COOKIE_SECURE=true

# --- Storage / networking -------------------------------------------------
DB_PATH=/data/app.db
LISTEN_ADDR=:8080

# --- Optional tuning ------------------------------------------------------
SESSION_TTL=12h
DEFAULT_USER_TTL=720h
